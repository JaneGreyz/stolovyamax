BOT_TOKEN=your_bot_token_here

# ID сотрудника, которому приходят заказы в личные сообщения
STAFF_USER_ID=

# Кто может менять дежурного командой /setstaff (через запятую)
ADMIN_IDS=

# Группа, из которой бот пересылает сообщения (меню и т.п.)
GROUP_CHAT_ID=

# Кому пересылать новые сообщения из группы (если пусто — STAFF_USER_ID)
GROUP_FORWARD_USER_ID=

DATABASE_PATH=data/bot.db
TIMEZONE=Europe/Moscow
WORK_START=8:45
FULL_MENU_START=8:45
WORK_END=16:45
WORK_WEEKDAYS_ONLY=1
SKIP_WORKING_HOURS=0
MIN_ORDER_AMOUNT=500

# Постоянное меню — файл bot/assets/permanent_menu.png
# DAILY_MENU_SHEET_ID / DAILY_MENU_GID больше не используются
